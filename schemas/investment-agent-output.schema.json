{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symbol",
    "market",
    "decision",
    "order",
    "references",
    "checklist",
    "checklistScore",
    "universeCheck",
    "positionSizing",
    "hardStopTriggered",
    "marketCircuitBreaker",
    "dataIntegrity",
    "riskFlags"
  ],
  "properties": {
    "symbol": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "enum": ["KR", "US"]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "confidence", "reason"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["BUY", "SELL", "HOLD"]
        },
        "confidence": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "order": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["quantity", "limitPrice", "currency"],
          "properties": {
            "quantity": {
              "type": "number"
            },
            "limitPrice": {
              "type": "number"
            },
            "currency": {
              "type": "string",
              "enum": ["KRW", "USD"]
            }
          }
        }
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "reason"],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priceSeriesFavorable",
        "newsDisclosureFavorable",
        "earningsDeteriorated",
        "negativeNewsDisclosure",
        "trendBroken",
        "volumeWeakening",
        "recentSpikeCooling",
        "isAveragingDown",
        "averagingDownAllowed"
      ],
      "properties": {
        "priceSeriesFavorable": { "type": "boolean" },
        "newsDisclosureFavorable": { "type": "boolean" },
        "earningsDeteriorated": { "type": "boolean" },
        "negativeNewsDisclosure": { "type": "boolean" },
        "trendBroken": { "type": "boolean" },
        "volumeWeakening": { "type": "boolean" },
        "recentSpikeCooling": { "type": "boolean" },
        "isAveragingDown": { "type": "boolean" },
        "averagingDownAllowed": { "type": "boolean" }
      }
    },
    "checklistScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buySeriesCount", "sellConditionCount"],
      "properties": {
        "buySeriesCount": { "type": "integer" },
        "sellConditionCount": { "type": "integer" }
      }
    },
    "universeCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isNewCandidate",
        "marketCapKrw",
        "avgTradeValue20dKrw",
        "return20dPct",
        "return5dPct"
      ],
      "properties": {
        "isNewCandidate": { "type": "boolean" },
        "marketCapKrw": { "type": ["number", "null"] },
        "avgTradeValue20dKrw": { "type": ["number", "null"] },
        "return20dPct": { "type": ["number", "null"] },
        "return5dPct": { "type": ["number", "null"] }
      }
    },
    "positionSizing": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposedAmountKrw", "isAddOnPurchase", "addOnCountToday"],
          "properties": {
            "proposedAmountKrw": { "type": "number" },
            "isAddOnPurchase": { "type": "boolean" },
            "addOnCountToday": { "type": "integer" }
          }
        }
      ]
    },
    "hardStopTriggered": { "type": "boolean" },
    "marketCircuitBreaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indexCrash", "viTriggered", "newBuySuspended"],
      "properties": {
        "indexCrash": { "type": "boolean" },
        "viTriggered": { "type": "boolean" },
        "newBuySuspended": { "type": "boolean" }
      }
    },
    "dataIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiError", "dataMissingFields", "newsDisclosureConflict"],
      "properties": {
        "apiError": { "type": "boolean" },
        "dataMissingFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "newsDisclosureConflict": { "type": "boolean" }
      }
    },
    "riskFlags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "STALE_NEWS",
          "NEWS_DISCLOSURE_CONFLICT",
          "PREFILTER_FAILED",
          "LOW_CONFIDENCE",
          "CHECKLIST_INSUFFICIENT",
          "AVERAGING_DOWN_BLOCKED",
          "CHASE_BUY_BLOCKED",
          "CIRCUIT_BREAKER_ACTIVE",
          "DATA_MISSING",
          "HARD_STOP_OVERRIDE",
          "POSITION_LIMIT_EXCEEDED"
        ]
      }
    }
  }
}
